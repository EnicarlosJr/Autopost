# Produção: copie para .env.production (fica fora do git) e troque TODOS os valores.
# Gere segredos com:  openssl rand -base64 48

# Endereços (registre os dois no DNS apontando para o IP do servidor).
PANEL_DOMAIN=painel.seudominio.com.br
PUBLIC_DOMAIN=listas.seudominio.com.br
# E-mail para o certificado HTTPS (o Let's Encrypt avisa por ele se algo der errado).
ACME_EMAIL=seu-email@exemplo.com

JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
ADMIN_EMAIL=voce@exemplo.com
# Senha do primeiro acesso (mínimo 12 caracteres). Depois, troque pelo painel.
ADMIN_PASSWORD=troque-por-uma-senha-longa
# Senha do banco: só vale na criação do volume. Use uma longa e guarde.
POSTGRES_PASSWORD=troque-por-uma-senha-longa-do-banco

REPOST_WINDOW_HOURS=24
PRICE_MAX_AGE_HOURS=6
LOG_RETENTION_DAYS=30
