# Copie para .env e troque os valores.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-this-to-a-long-unique-password
# Senha do Postgres. Só é aplicada quando o volume do banco é criado.
POSTGRES_PASSWORD=autopost
# Horas mínimas antes de repostar o mesmo produto no mesmo grupo (0 desativa).
REPOST_WINDOW_HOURS=24
# Horas máximas desde a última leitura de preço antes de enviar (0 desativa a conferência).
PRICE_MAX_AGE_HOURS=6
# Dias que o histórico do worker é mantido.
LOG_RETENTION_DAYS=30
VITE_API_URL=http://localhost:8000/api
